# === Sandbox (required for pushing code / Claude CLI) ===
ANTHROPIC_API_KEY=sk-ant-your-key-here
GITHUB_TOKEN=ghp_your-token-here
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your-email@example.com

# === Production only (not needed for sandbox) ===
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
SESSION_SECRET=random-string-here
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://user:password@host:5432/dbname
NODE_ENV=development

# Host printed on Gear labels (Phase 7, G2.4), e.g. http://localhost:5173 for local
# preview. NEVER hardcode this in code — the label URL must survive the app moving
# hosts (§6.4), which is the whole point of G2.3's durable label host. Do not point
# this at a real domain and print/apply labels until G2.3's redirect host exists.
LABEL_HOST=http://localhost:5173
